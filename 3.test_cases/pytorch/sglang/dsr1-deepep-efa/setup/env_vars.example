#!/usr/bin/env bash
# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: MIT-0
#
# Example env_vars for the SGLang + DeepEP-on-EFA DeepSeek-R1 sample.
# Copy this to setup/env_vars and fill in every REPLACE_ME:
#
#   cp setup/env_vars.example setup/env_vars
#   $EDITOR setup/env_vars
#   grep REPLACE_ME setup/env_vars   # should print nothing when fully set
#   source setup/env_vars
#
# Never commit setup/env_vars — it contains your HF token and account id.

# ---------------------------------------------------------------------------
# AWS / ECR (only needed if you push the image to ECR; a local build works too)
#
# Discover values once:
#   AWS_REGION=$(aws ec2 describe-availability-zones \
#                  --output text --query 'AvailabilityZones[0].[RegionName]')
#   ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
# Then paste the literals below — sourcing this file should not make AWS calls.
# ---------------------------------------------------------------------------
export AWS_REGION="REPLACE_ME"           # e.g. us-east-2
export ACCOUNT="REPLACE_ME"              # 12-digit AWS account id
export REGISTRY="${ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/"
export IMAGE="sglang-deepep-efa"
export TAG="sglang0.5.13.post1-deepep567632d-nvshmem3.7.0"

# Local image name used by the recipe scripts. Set this to
# "${REGISTRY}${IMAGE}:${TAG}" once the image is in ECR and pulled on every node.
export IMAGE_URI="sglang-deepep-efa:latest"

# ---------------------------------------------------------------------------
# Cluster topology — 2 nodes (p5.48xlarge or p5en.48xlarge), 8 GPU each.
#
# NODE_0 is the rank-0 / master node. Use PRIVATE IPs (the EFA-backed VPC
# interface), not public DNS. Discover with `hostname -I | awk '{print $1}'`
# on each node.
# ---------------------------------------------------------------------------
export NODE_0_IP="REPLACE_ME"            # rank 0 / master; a VPC-private IP
export NODE_1_IP="REPLACE_ME"            # rank 1

export NUM_NODES=2
export NUM_GPU_PER_NODE=8

# Primary ENA interface, used for the torch/gloo rendezvous (NOT for RDMA itself --
# NVSHMEM picks EFA devices via NVSHMEM_NETDEVS_POLICY).
#
# Derived from the default route rather than hardcoded. It is enp71s0 on p5 and
# p5en (measured here) and on p6-b200 (reported by @KeitaW, 2026-08-03), but a
# hardcoded name plus a prose table of which families it holds for rots as families
# come and go -- so this is the check written as code, and the name stops mattering.
# Override by exporting IFACE before sourcing this file.
#
# Only GLOO_SOCKET_IFNAME actually needs a concrete name (it takes comma-separated
# names only, no exclusion syntax). NCCL gets the instance-type-agnostic exclusion
# form NCCL_SOCKET_IFNAME=^docker,lo,veth from the serve scripts, matching
# micro-benchmarks/nccl-tests.
export IFACE="${IFACE:-$(ip -o -4 route show to default | awk '{print $5}' | head -1)}"

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
export MODEL="deepseek-ai/DeepSeek-R1"
export HF_TOKEN="REPLACE_ME"             # Optional: R1 is not gated, this only helps rate limits
# Host directory for the HF cache. DeepSeek-R1 is ~640 GB in FP8, so this must
# be on fast local NVMe, and the model must be present on BOTH nodes.
export HF_CACHE_DIR="/opt/dlami/nvme/hf"

# ---------------------------------------------------------------------------
# Serving config. TP=16 spans both nodes (2 x 8 GPU).
#
# MOE_BACKEND selects what is being compared:
#   deepep   = DeepEP-on-EFA dispatch/combine  (this sample)
#   baseline = SGLang's ordinary fused-MoE all-to-all over NCCL
#   tp       = no expert parallelism at all (MoE weights TP-sharded)
# ---------------------------------------------------------------------------
export MOE_BACKEND="deepep"
export TP_SIZE=16
export EP_SIZE=16
export SERVE_PORT=30000
export DIST_PORT=29500
# Left commented on purpose: serve.sh picks the right default for the
# --deepep-mode / backend in play (0.85 normally, 0.75 for DeepEP low_latency,
# 0.70 for UCCL low_latency). Set it here only to override all of them.
#export MEM_FRACTION_STATIC=0.85

# ---------------------------------------------------------------------------
# PD-disaggregated (2P2D) config — only needed for recipe/serve-pd.sh and
# recipe/benchmark-pd.sh. Requires 4 nodes: 2 prefill + 2 decode, each role a
# TP16/EP16 group. Leave these unset if you only run the colocated recipe.
#
# The KV cache moves prefill -> decode over EFA RDMA via Mooncake. Private IPs
# again, node 0 of each role being that role's rank-0 / master.
# See benchmarks/README.md for what these topologies measured.
# ---------------------------------------------------------------------------
export PREFILL_NODE_0_IP="REPLACE_ME"    # prefill rank 0 / master
export PREFILL_NODE_1_IP="REPLACE_ME"    # prefill rank 1
export DECODE_NODE_0_IP="REPLACE_ME"     # decode rank 0 / master
export DECODE_NODE_1_IP="REPLACE_ME"     # decode rank 1
# Host running sglang_router. Can be any of the four nodes or a separate one;
# benchmark-pd.sh drives the router, not the servers.
export ROUTER_IP="REPLACE_ME"

export PREFILL_PORT=30000
export DECODE_PORT=30001
export ROUTER_PORT=8000
export BOOTSTRAP_PORT=8998               # prefill KV bootstrap, per-prefill-node
export PREFILL_DIST_PORT=29500
export DECODE_DIST_PORT=29501

# Attention data-parallel across all 16 ranks of a role. Orthogonal to
# MOE_BACKEND, and it FLIPS the decode winner (helps EP-MoE ~+25-30%, hurts
# TP-MoE ~-10%) while hurting prefill for every backend. Off by default.
export DP_ATTENTION=0
export DP_SIZE=16

# Set UCCL=1 only when IMAGE_URI points at the UCCL-EP image. It switches on
# --privileged and a lower decode --mem-fraction-static, both of which UCCL
# needs and DeepEP does not, and it makes DEEPEP_MODE mandatory (UCCL's prefill
# path segfaults under --deepep-mode auto).
export UCCL=0
