# Copy to setup/env_vars (gitignored) and edit. Sourced by setup/build-push.sh.
export REGISTRY="123456789012.dkr.ecr.us-east-2.amazonaws.com"   # YOUR ECR — no registry is hardcoded anywhere
export IMAGE_NAME="vllm-deepep-v2-gdaki-efa"
export IMAGE_TAG="latest"
export AWS_REGION="us-east-2"
# Model: any MoE whose n_routed_experts % (data-parallel size) == 0. Default is public (no HF token).
export SERVE_MODEL="Qwen/Qwen3-30B-A3B-FP8"
export SERVE_DP="16"        # total data-parallel = EP size (16 = 2 nodes, 32 = 4 nodes)
export SERVE_DP_LOCAL="8"   # GPUs per node
# The GDAKI-stack pins (rdma-core / libfabric / aws-ofi-nccl SHAs, PR#1351 head, DeepEP base+PR)
# all carry immutable-SHA defaults in the Dockerfile + setup_deepep_v2_gdaki_efa.sh. Override an
# ARG at build time only to move a pin — the defaults reproduce the 2026-08-14 measured image.
