     }
 };
 
-constexpr int kNumNotifyWarps = 4;
+static int get_num_notify_warps(const int& num_ranks, const int& num_experts) {
+    EP_HOST_ASSERT(num_ranks > 0 and num_experts % num_ranks == 0);
+    // One notify thread is required for each scale-up rank and local expert.
+    // Using num_ranks is conservative for hybrid groups, where the number of
+    // scale-up ranks is no larger than the total number of ranks.
+    const int num_required_threads = num_ranks + num_experts / num_ranks;
+    const int num_notify_warps = math::align(math::ceil_div(num_required_threads, 32), 4);
+    EP_HOST_ASSERT(num_notify_warps > 0 and num_notify_warps < 32);
+    return num_notify_warps;
+}
 
 static int get_num_notify_smem_bytes(const int& num_ranks, const int& num_experts) {
-    return math::align(num_ranks + num_experts, kNumNotifyWarps * 32) * sizeof(int);
+    return math::align(num_ranks + num_experts,
+                       get_num_notify_warps(num_ranks, num_experts) * 32) * sizeof(int);
 }
 
