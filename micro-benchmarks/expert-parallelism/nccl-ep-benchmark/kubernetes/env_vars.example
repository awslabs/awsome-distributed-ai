#
# Copy to env_vars (ignored by the repository root .gitignore), fill in, then:
#   source env_vars
#   envsubst '$NAMESPACE $IMAGE_URI $INSTANCE_TYPE $NUM_NODES $GPU_PER_NODE $EFA_PER_NODE' \
#     < nccl-ep-mpijob.yaml | kubectl --context "$KUBE_CONTEXT" apply -f -
export KUBE_CONTEXT=<your-eks-context>
# The namespace must exist; the manifest never creates one.
export NAMESPACE=<existing-namespace>
# The image built from ../nccl-ep.Dockerfile, in a registry you own, with an immutable tag.
export IMAGE_URI=<your-registry>/nccl-ep-efa:<immutable-tag>
# The image has kernels for sm_90, sm_100 and sm_103. Only p5en.48xlarge was run with it;
# p5.48xlarge hits NVIDIA/nccl#2160 (see the README's version constraints and known limitations).
export INSTANCE_TYPE=p5en.48xlarge
export NUM_NODES=2
export GPU_PER_NODE=8
# EFA devices per node: p5en.48xlarge 16, p6-b200.48xlarge 8, p6-b300.48xlarge 16.
export EFA_PER_NODE=16
