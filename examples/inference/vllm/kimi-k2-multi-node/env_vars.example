# Copy this file to env_vars (gitignored), edit it, then source it:
#   cp env_vars.example env_vars && source env_vars

# AWS Deep Learning Container for vLLM, pinned to a dated tag.
export IMAGE=public.ecr.aws/deep-learning-containers/vllm:0.32.0-gpu-py312-cu130-ubuntu24.04-ec2-v1.1-2026-10-21-21-51-30
export INSTANCE_TYPE=p5en.48xlarge
export GPU_PER_NODE=8
export EFA_PER_NODE=16

# The instances' local NVMe, where each node keeps the model between deployments: /mnt/k8s-disks/0 on Amazon EKS
# nodes with a RAID0 instance store, /opt/dlami/nvme on the HyperPod DLAMI.
export NVME_HOST_PATH=/mnt/k8s-disks/0

# Kimi K2 Instruct-0905, FP8, pinned to a revision.
export MODEL_REPO=moonshotai/Kimi-K2-Instruct-0905
export MODEL_REVISION=ac6c49f04883bd0a0598b790693a72061c676629

# Layout: TP x PP must equal NUM_NODES x GPU_PER_NODE.
#   pipeline parallelism across two instances:  NUM_NODES=2 TP=8  PP=2
#   tensor parallelism across two instances:    NUM_NODES=2 TP=16 PP=1
#   one instance:                               NUM_NODES=1 TP=8  PP=1
export NUM_NODES=2
export TP=8
export PP=2
