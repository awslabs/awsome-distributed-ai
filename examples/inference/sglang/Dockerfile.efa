# Shared EFA-enabled SGLang image: upstream SGLang + the AWS EFA installer,
# the base for every multi-node example here (built/pushed by build-image.sh).
#
# The defaults build the Kimi image: v0.5.12.post1-cu130 (NIXL 1.1.0), pinned
# on purpose — see the NIXL note in kimi2.6-h200-1p1d/README.md before bumping.
# Samples that need a different SGLang build override BASE_IMAGE / EFA_VERSION
# through build-image.sh rather than carrying their own copy of this layer;
# each sample's README gives its values.
ARG BASE_IMAGE=lmsysorg/sglang:v0.5.12.post1-cu130
FROM ${BASE_IMAGE}

ARG EFA_VERSION=1.47.0

RUN apt-get update && apt-get install -y --no-install-recommends \
      pciutils environment-modules tcl \
      libnl-3-dev libnl-route-3-dev \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN cd /tmp \
  && curl -O https://s3-us-west-2.amazonaws.com/aws-efa-installer/aws-efa-installer-${EFA_VERSION}.tar.gz \
  && tar -xf aws-efa-installer-${EFA_VERSION}.tar.gz \
  && cd aws-efa-installer \
  && ./efa_installer.sh -y --skip-kmod -g \
  && rm -rf /tmp/aws-efa-installer*

ENV PATH="/opt/amazon/efa/bin:/opt/amazon/openmpi/bin:$PATH"
ENV LD_LIBRARY_PATH="/opt/amazon/ofi-nccl/lib:/opt/amazon/efa/lib:/opt/amazon/openmpi/lib:$LD_LIBRARY_PATH"

ENV FI_PROVIDER=efa
ENV FI_EFA_USE_DEVICE_RDMA=1
