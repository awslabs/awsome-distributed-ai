{
 "uid": "llmd-dsv4flash-flowcontrol",
 "title": "llm-d flow control: DeepSeek-V4-Flash",
 "tags": [
  "sglang",
  "llm-d",
  "flow-control"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "description": "examples/inference/llm-d/dsv4flash-agg with router/flow-control.values.yaml: EPP flow-control queues by priority and fairness ID. Needs the llmd-epp and sglang scrape jobs of observability/prometheus-grafana/eks-managed-observability. Panels show no data until the overlay is on and the pool saturates.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source",
    "current": {}
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "label": "Namespace",
    "query": {
     "query": "label_values(up{job=\"epp\"}, namespace)",
     "refId": "ns"
    },
    "refresh": 2,
    "current": {
     "text": "dsv4flash-llmd",
     "value": "dsv4flash-llmd"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Saturation",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Pool saturation",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "EPP queues requests while this is >= 1 (in-flight requests >= ready replicas x maxConcurrency). Stage 'effective' is the value used for gating.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(llm_d_epp_flow_control_pool_saturation{job=\"epp\",namespace=\"$namespace\",stage=\"effective\"})",
     "legendFormat": "saturation",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Where requests wait: EPP vs SGLang",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "With flow control working, the backlog sits in the EPP queue and the SGLang queues stay short. Without it (or with maxConcurrency too high), the backlog is in SGLang.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(llm_d_epp_flow_control_queue_size{job=\"epp\",namespace=\"$namespace\"})",
     "legendFormat": "EPP queue",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(sglang:num_queue_reqs{job=\"sglang\",namespace=\"$namespace\"})",
     "legendFormat": "SGLang queues",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(sglang:num_running_reqs{job=\"sglang\",namespace=\"$namespace\"})",
     "legendFormat": "SGLang running",
     "refId": "C"
    }
   ]
  },
  {
   "type": "row",
   "title": "By priority",
   "id": 4,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Queued requests by priority",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Requests waiting in EPP per priority band. Higher bands should drain first.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (priority) (llm_d_epp_flow_control_queue_size{job=\"epp\",namespace=\"$namespace\"})",
     "legendFormat": "priority {{priority}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Queue time P90 by priority",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Time from enqueue to dispatch for dispatched requests. Premium should stay near 0 while lower bands absorb the wait. The histogram's largest finite bucket is 60 s while defaultRequestTTL is 300 s, so values cap at 60 s: a P90 of 60 means 60 s or more.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.9, sum by (le, priority) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_bucket{job=\"epp\",namespace=\"$namespace\",outcome=\"Dispatched\"}[$__rate_interval])))",
     "legendFormat": "priority {{priority}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Request outcomes by priority",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Dispatched, RejectedCapacity (band or global queue full, 429 rejected-saturated), EvictedTTL (waited past defaultRequestTTL, 429 rejected-ttl-expired), EvictedContextCancelled (client gave up).",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (priority, outcome) (rate(llm_d_epp_flow_control_requests_total{job=\"epp\",namespace=\"$namespace\"}[$__rate_interval]))",
     "legendFormat": "{{priority}} {{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Band queue occupancy",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Queued requests / band maxRequests. At 100% the band rejects new requests.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (priority) (llm_d_epp_flow_control_capacity_utilization_requests{job=\"epp\",namespace=\"$namespace\"})",
     "legendFormat": "priority {{priority}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "By fairness ID",
   "id": 9,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 26
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Queued requests by fairness ID",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Requests waiting per x-llm-d-inference-fairness-id (default-flow without the header). Within a band, flows are served round-robin.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 27
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (fairness_id, priority) (llm_d_epp_flow_control_queue_size{job=\"epp\",namespace=\"$namespace\"})",
     "legendFormat": "{{fairness_id}} (p{{priority}})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Queue time P90 by fairness ID",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Per-flow wait for dispatched requests. The histogram's largest finite bucket is 60 s while defaultRequestTTL is 300 s, so values cap at 60 s: a P90 of 60 means 60 s or more.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 27
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.9, sum by (le, fairness_id) (rate(llm_d_epp_flow_control_request_queue_duration_seconds_bucket{job=\"epp\",namespace=\"$namespace\",outcome=\"Dispatched\"}[$__rate_interval])))",
     "legendFormat": "{{fairness_id}}",
     "refId": "A"
    }
   ]
  }
 ]
}
