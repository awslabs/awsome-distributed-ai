     "expr": "sum(rate(llm_d_epp_prefix_best_available_cached_tokens_sum{job=\"epp\",namespace=\"$namespace\"}[$__rate_interval])) / sum(rate(llm_d_epp_prefix_prompt_tokens_sum{job=\"epp\",namespace=\"$namespace\"}[$__rate_interval]))",
