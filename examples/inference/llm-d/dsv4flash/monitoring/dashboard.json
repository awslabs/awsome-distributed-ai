{
 "uid": "llmd-dsv4flash",
 "title": "llm-d + SGLang: DeepSeek-V4-Flash",
 "tags": [
  "sglang",
  "llm-d"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "description": "examples/inference/llm-d/dsv4flash: SGLang replicas behind the llm-d EPP. Needs the sglang and dcgm-exporter scrape jobs of observability/prometheus-grafana/eks-managed-observability plus its llmd-epp scrape job (scrape-configs/llmd-epp.yaml).",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source",
    "current": {}
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "label": "Namespace",
    "query": {
     "query": "label_values(up{job=\"sglang\"}, namespace)",
     "refId": "ns"
    },
    "refresh": 2,
    "current": {
     "text": "dsv4flash-llmd",
     "value": "dsv4flash-llmd"
    }
   },
   {
    "name": "pod",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "label": "Pod",
    "includeAll": true,
    "multi": true,
    "query": {
     "query": "label_values(up{job=\"sglang\",namespace=\"$namespace\"}, pod)",
     "refId": "pod"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   },
   {
    "name": "node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "label": "Node",
    "includeAll": true,
    "multi": true,
    "query": {
     "query": "label_values(up{job=\"sglang\",namespace=\"$namespace\"}, kubernetes_node)",
     "refId": "node"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Replicas up",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count(up{job=\"sglang\",namespace=\"$namespace\",pod=~\"$pod\"} == 1)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Request throughput",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 3,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(sglang:num_requests_total{job=\"sglang\",namespace=\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
