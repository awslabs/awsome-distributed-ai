# Copy to .env; use absolute paths accessible on login and compute nodes.
PARTITION=aim347
COMPUTE_NODES=aim347-g7e-1,aim347-g7e-2
DATA_DIR=/fsx/aim347/participant
LAB_IMAGE=/fsx/aim347/participant/aim347-lab.sqsh
VLLM_IMAGE=/fsx/aim347/participant/vllm-v0.20.2.sqsh
RUN_ID=participant-trial-a
# g7e.12xlarge reference configuration; record the actual allocation before use.
INSTANCE_TYPE=g7e.12xlarge
# Confirm with ip route get <peer-private-IP> on each node.
NCCL_SOCKET_IFNAME==ens5
# Set the allocated hardware's measured dense ceiling in TFLOP/s per GPU.
DENSE_TFLOPS=
STEPS=100
WARMUP=10
MICROBATCH=1
CPU_ROUNDS=2000
# Private login-node address, reachable from compute nodes. Grafana stays loopback.
LOGIN_BIND_IP=10.0.0.10
PUSHGATEWAY_URL=http://10.0.0.10:9091

# Optional bounded allocation: GPU count/node, vCPUs/rank, and GiB/node.
# LAB_GPUS_PER_NODE=4
# LAB_CPUS_PER_TASK=24
# LAB_MEMORY_PER_NODE=384G
# LAB_NODE_LOCAL=1
# AIM_ENFORCE_STANDIN=1
# Select from actual device assignment; RDMA below was measured on G7.
# DCGM_EXPORTER_DEVICES=g:0-3
# FI_EFA_IFACE=rdmap83s0
# OFI_NCCL_PROTOCOL=RDMA
