        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tokens/s"
        },
        "overrides": []
      },
      "description": ""
    },
    {
      "id": 22,
      "title": "vLLM TTFT p50",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": ""
    },
    {
