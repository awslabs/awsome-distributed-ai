    {
      "id": 21,
      "title": "vLLM output throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
