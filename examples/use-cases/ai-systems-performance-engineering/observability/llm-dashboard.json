{
  "uid": "aim347-llm",
  "title": "AIM347 dense LLM measurements",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Recorded run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "aim347-prometheus"
        },
        "query": "label_values({__name__=~\"aim347_llm_.*\"}, run_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Assigned nodes",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "aim347-prometheus"
        },
        "query": "label_values(up{job=\"node\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Training throughput: completed window",
      "description": "Useful nonpadding prediction tokens divided by the continuous post-warmup interval. A completed-window gauge, not an instantaneous rate.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aim347_llm_training_throughput_tokens_per_second{run_id=~\"$run\"}",
          "legendFormat": "{{config}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tokens/s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Training goodput: complete campaign",
      "description": "Final durable progress divided by the complete retained-allocation campaign interval, including interruption, restore and replay. Replay is credited once.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aim347_llm_training_goodput_campaign_tokens_per_second{run_id=~\"$run\"}",
          "legendFormat": "{{config}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tokens/s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Training goodput: resumed segment",
      "description": "Only the recorded process segment. Earlier failed execution and downtime are excluded.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aim347_llm_training_goodput_segment_tokens_per_second{run_id=~\"$run\"}",
          "legendFormat": "{{config}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tokens/s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Serving goodput: quality and both latency conditions",
      "description": "Completed exact-JSON requests meeting both declared TTFT and TPOT conditions per measured second. The client uses closed-loop slots.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aim347_llm_serving_goodput_requests_per_second{run_id=~\"$run\"}",
          "legendFormat": "{{config}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Serving offered / qualified / failed requests",
      "description": "Counts from the entire finite request set. Failed requests remain in offered totals. Select the same request hash, load and SLO when comparing configurations.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aim347_llm_serving_offered_requests{run_id=~\"$run\"}",
          "legendFormat": "Offered {{config}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "aim347_llm_serving_qualified_requests{run_id=~\"$run\"}",
          "legendFormat": "Qualified {{config}}",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "aim347_llm_serving_failed_requests{run_id=~\"$run\"}",
          "legendFormat": "Failed {{config}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Campaign tokens per allocated GPU-hour",
      "description": "The campaign retains its GPUs for the full recorded interval. Preparation and initial allocation waiting before controller start are outside this value.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aim347_llm_campaign_tokens_per_allocated_gpu_hour{run_id=~\"$run\"}",
          "legendFormat": "{{config}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tokens/GPU-hour",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "GPU framebuffer memory",
      "description": "Measured MiB per GPU. Match the selected nodes and time range to the recorded run; exporters are node-wide.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED{node=~\"$node\"}",
          "legendFormat": "{{node}} GPU {{gpu}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mebibytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "GPU SM activity",
      "description": "Measured activity ratio when profiling counters are available. Missing/sentinel values are not zero utilization. Values outside the defined ratio range are filtered, not clamped.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(DCGM_FI_PROF_SM_ACTIVE{node=~\"$node\"} >= 0) <= 1",
          "legendFormat": "{{node}} GPU {{gpu}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "EFA transmitted / received bytes per second",
      "description": "Rate of actual cumulative NIC counters. Attribute traffic using placement, provider logs and the run interval; these counters are not process-specific.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_amazonefa_tx_bytes{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{device}} TX"
        },
        {
          "refId": "B",
          "expr": "rate(node_amazonefa_rx_bytes{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{device}} RX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Lustre read / written bytes per second",
      "description": "Rates of llite byte sums. Select the task mount. Node-wide counters include other I/O on the same filesystem.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(lustre_read_bytes_total{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{mount}} Read"
        },
        {
          "refId": "B",
          "expr": "rate(lustre_write_bytes_total{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{mount}} Write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Lustre collection health",
      "description": "A value of one indicates the collector obtained Lustre counters. Missing data or zero means the I/O panels need investigation.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aim347_lustre_collection_success{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "title": "Server inter-token latency: observed 95th percentile",
      "description": "Server output-event histogram from vLLM. It is separate from per-request client TPOT and depends on scrape coverage and the finite sample count.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aim347-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(vllm:inter_token_latency_seconds_bucket{node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "{{node}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    }
  ],
  "description": "Draft dashboard for actual dense LLM runs. Completed-result gauges and live node-wide telemetry have distinct scopes. Select matching workload/configurations and set the measured UTC interval."
}
