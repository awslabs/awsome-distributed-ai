+def mlflow_log(metrics: Dict[str, float], step: int) -> None:
+    """Mirror a wandb.log call to MLflow (SageMaker managed tracking server).
+
+    No-op unless an MLflow run is active (started in scripts/train.py on rank 0).
+    """
+    if mlflow is None or mlflow.active_run() is None:
+        return
+    try:
+        # MLflow only allows alphanumerics, _ - . space : / in metric names.
+        mlflow.log_metrics(
+            {
+                re.sub(r"[^A-Za-z0-9_\-. :/]", "", k): float(v)
+                for k, v in metrics.items()
+                if isinstance(v, (int, float))
+            },
+            step=step,
+        )
+    except Exception:
+        log.warning("Failed to log metrics to MLflow", exc_info=True)
+
 
